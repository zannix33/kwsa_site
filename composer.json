{
    "name": "brownpaperbag/modulatte",
    "type": "project",
    "description": "A project by Brown Paper Bag.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "area17/twill": "2.10",
        "artesaos/seotools": "^0.20.1",
        "binarytorch/larecipe": "^2.4",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "kalnoy/nestedset": "^6.0",
        "laravel/framework": "^8.40",
        "laravel/tinker": "^2.5",
        "laravelcollective/html": "^6.2",
        "maatwebsite/excel": "^3.1",
        "silviolleite/laravelpwa": "^2.0",
        "spatie/laravel-analytics": "3.*",
        "spatie/laravel-ray": "^1.17",
        "spatie/laravel-responsecache": "^7.1",
        "spatie/laravel-sitemap": "^6.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "beyondcode/helo-laravel": "^1.3",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^3.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "autoload": {
        "files": [
            "packages/modulatte/core/src/Concepts/SEO/seo.php",
            "packages/modulatte/core/src/Concepts/Pages/pages.php",
            "packages/modulatte/core/src/Concepts/Globals/globals.php"
        ],
        "classmap": [
            "packages/modulatte/core/src/database/migrations"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modulatte\\Core\\": "packages/modulatte/core/src/",
            "Modulatte\\Core\\Database\\Factories\\": "packages/modulatte/core/src/database/factories",
            "Modulatte\\Core\\Database\\Seeders\\": "packages/modulatte/core/src/database/seeders"            
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
